@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/UiResTargets.cmake")

get_target_property(_INCLUDE_DIRS UiRes::UiRes INTERFACE_INCLUDE_DIRECTORIES)

string(TOUPPER ${CMAKE_BUILD_TYPE} _BUILD_TYPE)

get_target_property(_LIBRARIES UiRes::UiRes "IMPORTED_LOCATION_${_BUILD_TYPE}")
get_target_property(_DEPENDENCIES UiRes::UiRes INTERFACE_LINK_LIBRARIES)

set(UiRes_INCLUDE_DIRS ${_INCLUDE_DIRS})
set(UiRes_LIBRARIES ${_LIBRARIES} ${_DEPENDENCIES})
set(UiRes_LIBRARY ${_LIBRARIES})

cmake_path(GET CMAKE_CURRENT_LIST_DIR PARENT_PATH UiRes_RELEASE_ROOT)

set(UiRes_LIBRARY_DIRS "${UiRes_RELEASE_ROOT}/lib")

message(STATUS "UIRES LIBRARY DIRECTORIES : ${UiRes_LIBRARY_DIRS}")