@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/UiTsysTargets.cmake")

get_target_property(_INCLUDE_DIRS UiTsys::UiTsys INTERFACE_INCLUDE_DIRECTORIES)

string(TOUPPER ${CMAKE_BUILD_TYPE} _BUILD_TYPE)

get_target_property(_LIBRARIES UiTsys::UiTsys "IMPORTED_LOCATION_${_BUILD_TYPE}")
get_target_property(_DEPENDENCIES UiTsys::UiTsys INTERFACE_LINK_LIBRARIES)

set(UiTsys_INCLUDE_DIRS ${_INCLUDE_DIRS})
set(UiTsys_LIBRARIES ${_LIBRARIES} ${_DEPENDENCIES})
set(UiTsys_LIBRARY ${_LIBRARIES})

cmake_path(GET CMAKE_CURRENT_LIST_DIR PARENT_PATH UiTsys_RELEASE_ROOT)

set(UiTsys_LIBRARY_DIRS "${UiTsys_RELEASE_ROOT}/lib")

message(STATUS "UITSYS LIBRARY DIRECTORIES : ${UiTsys_LIBRARY_DIRS}")